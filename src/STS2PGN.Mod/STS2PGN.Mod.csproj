<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>STS2_PGN</AssemblyName>
    <RootNamespace>STS2PGN.Mod</RootNamespace>

    <STS2GameDir Condition="'$(STS2GameDir)' == ''">$(STS2_GAME_DIR)</STS2GameDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' == 'Windows_NT'">$(STS2GameDir)/data_sts2_windows_x86_64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2GameDataDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' != 'Windows_NT' and !$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/data_sts2_linuxbsd_x86_64</STS2GameDataDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      STS2 loads only the assembly named by the mod manifest and does not probe sibling
      managed dependencies. Link the portable Core sources into the mod assembly so
      STS2_PGN.dll is self-contained. STS2PGN.Core remains a separate project for
      simulators, tools, and tests.
    -->
    <Compile Include="../STS2PGN.Core/FormatConstants.cs" Link="Core/FormatConstants.cs" />
    <Compile Include="../STS2PGN.Core/Model/**/*.cs" Link="Core/Model/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../STS2PGN.Core/Parsing/**/*.cs" Link="Core/Parsing/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../STS2PGN.Core/Scripting/**/*.cs" Link="Core/Scripting/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../STS2PGN.Core/Serialization/**/*.cs" Link="Core/Serialization/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../STS2PGN.Core/Validation/**/*.cs" Link="Core/Validation/%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../../mod_manifest.json" Link="STS2_PGN.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../STS2_PGN.config.json" Link="STS2_PGN.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateGameAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(STS2GameDataDir)/sts2.dll')" Text="Could not find sts2.dll. Set STS2_GAME_DIR or pass -p:STS2GameDir=&quot;/path/to/Slay the Spire 2&quot;; alternatively pass -p:STS2GameDataDir=&quot;/path/to/game/data directory&quot;." />
    <Error Condition="!Exists('$(STS2GameDataDir)/GodotSharp.dll')" Text="Could not find GodotSharp.dll in '$(STS2GameDataDir)'." />
    <Error Condition="!Exists('$(STS2GameDataDir)/0Harmony.dll')" Text="Could not find 0Harmony.dll in '$(STS2GameDataDir)'." />
  </Target>
</Project>
